{
  "name": "@juanrgon/pi-code-mode",
  "version": "0.2.0",
  "description": "Code Mode extension for pi — the LLM writes TypeScript that composes pi's core tools with real parallelism, delegating to pi's actual tool implementations",
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-mode",
    "typescript",
    "sandbox"
  ],
  "license": "MIT",
  "author": "juanrgon",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanrgon/pi-code-mode"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "^1.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
